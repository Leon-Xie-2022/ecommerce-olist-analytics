table dim_date
	lineageTag: b044aa66-7a8a-4449-9ff1-b56d6511401d
	dataCategory: Time

	column date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		lineageTag: 8bb79922-735f-4f2e-8461-16af8910f928
		summarizeBy: none
		sourceColumn: date

		annotation UnderlyingDateTimeDataType = Date

	column month_start
		dataType: dateTime
		formatString: yyyy-mm
		lineageTag: ecde0fb2-c819-4599-b156-0c12a91d7d37
		summarizeBy: none
		sourceColumn: month_start

		annotation UnderlyingDateTimeDataType = Date

	column year_month
		dataType: string
		lineageTag: 7f77999c-e389-4980-b802-61ebe7f462c9
		summarizeBy: none
		sourceColumn: year_month

	column year
		dataType: int64
		formatString: 0
		lineageTag: 87df621b-66b5-4a76-bd7a-e1abb1f6251d
		summarizeBy: none
		sourceColumn: year

	column month
		dataType: int64
		formatString: 0
		lineageTag: ae45e65a-654b-4197-bd1c-07060fa7a8c5
		summarizeBy: none
		sourceColumn: month

	partition dim_date = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(DataFolder & "dim_date.parquet")),
				    Filtered = Table.SelectRows(Source, each [is_complete_month]),
				    Selected = Table.SelectColumns(Filtered, {"date", "month_start", "year_month", "year", "month"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"date", type date}, {"month_start", type date}, {"year_month", type text}, {"year", Int64.Type}, {"month", Int64.Type}})
				in
				    Typed

