table dim_date
	lineageTag: 1d9ef43c-c1e0-4f37-8833-bd95993642c9
	dataCategory: Time

	column date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		lineageTag: c17dbf6a-1925-4fa3-94c1-2b480baca417
		summarizeBy: none
		sourceColumn: date

		annotation UnderlyingDateTimeDataType = Date

	column month_start
		dataType: dateTime
		formatString: yyyy-mm
		lineageTag: e51d3048-d904-4380-a52f-f9dd29d9f288
		summarizeBy: none
		sourceColumn: month_start

		annotation UnderlyingDateTimeDataType = Date

	column year_month
		dataType: string
		lineageTag: b8f2eda0-ea33-40a2-b753-d0f4ce6d5468
		summarizeBy: none
		sourceColumn: year_month

	column year
		dataType: int64
		formatString: 0
		lineageTag: 6e007a1e-20e9-4923-972b-ce88ef14396d
		summarizeBy: none
		sourceColumn: year

	column month
		dataType: int64
		formatString: 0
		lineageTag: 4b1a2f00-79b4-4677-9cb8-2b159ae76062
		summarizeBy: none
		sourceColumn: month

	partition dim_date = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(DataFolder & "dim_date.parquet")),
				    Filtered = Table.SelectRows(Source, each [is_complete_month]),
				    Selected = Table.SelectColumns(Filtered, {"date", "month_start", "year_month", "year", "month"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"date", type date}, {"month_start", type date}, {"year_month", type text}, {"year", Int64.Type}, {"month", Int64.Type}})
				in
				    Typed

