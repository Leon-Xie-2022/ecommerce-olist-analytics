table _Measures
	lineageTag: e6987616-188c-4cd7-98a4-eb5b7637a966

	/// Orders excluding canceled and unavailable
	measure 'Valid Orders' = CALCULATE(COUNTROWS(fct_orders), fct_orders[is_valid] = TRUE())
		formatString: #,0
		lineageTag: 94d8b787-0f21-4b23-a576-86b512b16233

	/// Sum of item prices of valid orders (BRL); not company revenue
	measure 'Product Value' = CALCULATE(SUM(fct_orders[product_value]), fct_orders[is_valid] = TRUE())
		formatString: #,0
		lineageTag: 22ee00cc-de1c-4b23-b047-f8fc718ab3d0

	/// Freight charged on valid orders (BRL)
	measure 'Freight Value' = CALCULATE(SUM(fct_orders[freight_value]), fct_orders[is_valid] = TRUE())
		formatString: #,0
		lineageTag: 04310651-9863-4e24-b63b-410daae8eaa0

	/// Average product value per valid order with items (BRL)
	measure AOV =
			DIVIDE(
			    [Product Value],
			    CALCULATE(COUNTROWS(fct_orders), fct_orders[is_valid] = TRUE(), fct_orders[n_items] > 0)
			)
		formatString: #,0.00
		lineageTag: 5b98bef8-a9a2-496e-9051-8b2dfe443d2e

	/// Change in product value vs the previous month
	measure 'Product Value MoM %' =
			VAR CurrentValue = [Product Value]
			VAR PreviousValue = CALCULATE([Product Value], DATEADD(dim_date[date], -1, MONTH))
			RETURN
			    IF(NOT ISBLANK(PreviousValue), DIVIDE(CurrentValue - PreviousValue, PreviousValue))
		formatString: 0.0%
		lineageTag: 8da4afb1-b17c-4cdf-a999-4cd1c31bdef5

	/// Status delivered and a recorded delivery date
	measure 'Delivered Orders' = CALCULATE(COUNTROWS(fct_orders), fct_orders[is_delivered] = TRUE())
		formatString: #,0
		lineageTag: f1226d19-5bf0-4633-a1c3-0da994118b20

	/// Delivered after the estimated date (calendar days)
	measure 'Late Orders' = CALCULATE(COUNTROWS(fct_orders), fct_orders[is_late] = TRUE())
		formatString: #,0
		lineageTag: 0e50dd9c-5040-4dfb-984a-04b9b6258b99

	/// Late orders / delivered orders
	measure 'Late Rate' = DIVIDE([Late Orders], [Delivered Orders])
		formatString: 0.0%
		lineageTag: 476ad57f-f51f-410f-97b0-6c3faab26629

	/// Days from purchase to delivery
	measure 'Avg Delivery Days' = CALCULATE(AVERAGE(fct_orders[delivery_days]), fct_orders[is_delivered] = TRUE())
		formatString: 0.0
		lineageTag: 174c272b-587f-4d1d-99c3-ef3aa4c3dac4

	/// Average 1-5 review score of valid reviewed orders
	measure 'Avg Review Score' = CALCULATE(AVERAGE(fct_orders[review_score]), fct_orders[is_valid] = TRUE())
		formatString: 0.00
		lineageTag: 2e9b27e6-e281-4e53-be71-726b9b6c2947

	/// Share of 1-2 star reviews among reviewed valid orders
	measure 'Low Review Share' =
			DIVIDE(
			    CALCULATE(COUNTROWS(fct_orders), fct_orders[is_valid] = TRUE(), fct_orders[review_score] IN {1, 2}),
			    CALCULATE(COUNT(fct_orders[review_score]), fct_orders[is_valid] = TRUE())
			)
		formatString: 0.0%
		lineageTag: e6ee3d5b-033a-4d88-89f1-78c9ee2db22e

	/// Distinct people (customer_unique_id) with a valid order
	measure Customers = CALCULATE(DISTINCTCOUNT(fct_orders[customer_unique_id]), fct_orders[is_valid] = TRUE())
		formatString: #,0
		lineageTag: 2e476d7a-0322-498b-addf-ddcc5f601147

	/// Valid orders placed on a later day than the customer's first purchase
	measure 'Returning Order Share' =
			DIVIDE(
			    CALCULATE(COUNTROWS(fct_orders), fct_orders[is_return_order] = TRUE()),
			    [Valid Orders]
			)
		formatString: 0.0%
		lineageTag: add772b8-f9f1-4be8-aae2-3d925a651432

	/// Customers (cohorts 2017-01..2018-08) who bought on 2+ different days
	measure 'Repeat Customer Share' =
			DIVIDE(
			    CALCULATE(COUNTROWS(dim_customer), dim_customer[is_repeat_customer] = TRUE()),
			    COUNTROWS(dim_customer)
			)
		formatString: 0.0%
		lineageTag: dc56a977-e893-485a-9020-67a2f5a276b0

	/// Item-level product value, for category and seller analysis
	measure 'Item Product Value' = CALCULATE(SUM(fct_order_items[price]), fct_order_items[is_valid] = TRUE())
		formatString: #,0
		lineageTag: e51dabdf-fdd5-42ce-b1dd-28307d59288b

	/// Category product value / all categories
	measure 'Category Share' = DIVIDE([Item Product Value], CALCULATE([Item Product Value], ALL(fct_order_items[category])))
		formatString: 0.0%
		lineageTag: 57d68106-ca44-4763-9790-09d23edfbf17

	/// Average review score of delivered orders; used with delivery outcome
	measure 'Avg Review Score (Delivered)' = CALCULATE(AVERAGE(fct_orders[review_score]), fct_orders[is_delivered] = TRUE())
		formatString: 0.00
		lineageTag: bb498d33-3dfa-40d2-892a-436c57673be4

	/// Share of 1-2 star reviews among reviewed delivered orders
	measure 'Low Review Share (Delivered)' =
			DIVIDE(
			    CALCULATE(COUNTROWS(fct_orders), fct_orders[is_delivered] = TRUE(), fct_orders[review_score] IN {1, 2}),
			    CALCULATE(COUNT(fct_orders[review_score]), fct_orders[is_delivered] = TRUE())
			)
		formatString: 0.0%
		lineageTag: be946204-d231-4934-9fad-febacdaf8686

	column Value
		isHidden
		formatString: 0
		lineageTag: e270d01a-ac5c-4e67-ac14-d9262c01ac61
		summarizeBy: none
		isNameInferred
		sourceColumn: [Value]

	partition _Measures = calculated
		mode: import
		source = {0}

