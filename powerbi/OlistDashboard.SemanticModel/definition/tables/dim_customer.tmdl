table dim_customer
	lineageTag: 8cffeeea-f50d-4bdd-afbf-a3a1f64c7c03

	column customer_unique_id
		dataType: string
		isHidden
		lineageTag: 3891af1f-fbf7-46fd-b660-cc7aba85d537
		summarizeBy: none
		sourceColumn: customer_unique_id

	column cohort_month
		dataType: dateTime
		formatString: yyyy-mm
		lineageTag: c00057dd-c4fa-4f81-a3c8-40a046ed1bfe
		summarizeBy: none
		sourceColumn: cohort_month

		annotation UnderlyingDateTimeDataType = Date

	column n_orders
		dataType: int64
		formatString: 0
		lineageTag: 6bd213de-a31b-43e2-ad6f-cc4a6ab6f3d2
		summarizeBy: none
		sourceColumn: n_orders

	column n_purchase_days
		dataType: int64
		formatString: 0
		lineageTag: 1aacd4ca-f3ed-4364-8ed8-c4370339cee3
		summarizeBy: none
		sourceColumn: n_purchase_days

	column first_order_state
		dataType: string
		lineageTag: 83f8090f-3ddb-4afe-ada2-dfe34ea0a6e2
		summarizeBy: none
		sourceColumn: first_order_state

	column is_repeat_customer
		dataType: boolean
		lineageTag: 2c030db7-fe25-4981-a1d9-a1c83fa49cc0
		summarizeBy: none
		sourceColumn: is_repeat_customer

	partition dim_customer = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(DataFolder & "dim_customer.parquet")),
				    Filtered = Table.SelectRows(Source, each [cohort_month] >= #date(2017, 1, 1) and [cohort_month] <= #date(2018, 8, 1)),
				    Selected = Table.SelectColumns(Filtered, {"customer_unique_id", "cohort_month", "n_orders", "n_purchase_days", "first_order_state", "is_repeat_customer"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"customer_unique_id", type text}, {"cohort_month", type date}, {"n_orders", Int64.Type}, {"n_purchase_days", Int64.Type}, {"first_order_state", type text}, {"is_repeat_customer", type logical}})
				in
				    Typed

